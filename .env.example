# Environment variables for the Legal Assistant project
# Copy this file to .env and fill in your values

# --- Tesseract OCR (required for scanned PDFs) ---
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Ollama (for dataset generation) ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=mistral

# --- Hugging Face (for downloading models) ---
# Get a token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=legal_assistant

# --- Model Configuration ---
BASE_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2
FINE_TUNED_MODEL_PATH=models/legal_llm/final
